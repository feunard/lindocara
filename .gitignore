node_modules/
dist/
*.tsbuildinfo
.dev.vars*
.wrangler/

.DS_Store
.idea/
.vscode/

# Playwright MCP scratch output
.playwright-mcp/
.playwright-cli/

# Agent dev/verification scratch: captured dev logs and root-level screenshots.
# The real game assets live under public/assets/ and are not matched here.
.codex-dev.*.log
/*.png
artifacts/
.superpowers/

# Agent worktrees and local agent state. Worktree contents are checkouts of this
# same repo — tracking them would commit the repo into itself.
# Excluding the contents rather than the directory itself: git never descends into an
# excluded directory, so `.claude/` would make the skills exception below unreachable.
.claude/*
# Skills are project tooling, shared by everyone working here.
!.claude/skills/

wireframes

# `alepha pack` writes the artifact next to the app when -o is omitted.
*.tar.gz

# ACE-Step writes progress estimates next to the working directory.
.cache/
