node_modules/

# Yarn's own state. `yarn.lock` and `.yarnrc.yml` are tracked; everything the install
# writes under `.yarn/` is machine-local — the cache is global (`~/.yarn/berry/cache`)
# and `install-state.gz` is a resolution snapshot. Same line as ../alepha and ../club.
.yarn

__pycache__/
*.py[cod]
dist/
# The lab's client build. It lives outside `dist/` on purpose — `alepha build` cleans `dist/`
# before any task runs, so a client written there would be deleted before the static target could
# adopt it (see `apps/lab/alepha.config.ts`).
dist-client/
*.tsbuildinfo
.dev.vars*
.wrangler/

# Local environment files. `APP_SECRET` lives in `.env.production` on a machine that
# deploys by hand — alepha's CLI loads `.env` then `.env.$NODE_ENV` into `process.env`,
# and the SecretProvider THROWS in production when the secret is defaulted. Never commit
# one: a secret in git history is a secret that has to be rotated, and rotating this one
# invalidates every live session. `.env.example` stays tracked as documentation.
.env
.env.*
!.env.example

.DS_Store
.idea/
.vscode/

# Playwright MCP scratch output
.playwright-mcp/
.playwright-cli/

# Agent dev/verification scratch: captured dev logs and root-level screenshots.
# The real game assets live under public/assets/ and are not matched here.
.codex-dev.*.log
/*.png
artifacts/
.superpowers/

# Agent worktrees and local agent state. Worktree contents are checkouts of this
# same repo — tracking them would commit the repo into itself.
# Excluding the contents rather than the directory itself: git never descends into an
# excluded directory, so `.claude/` would make the skills exception below unreachable.
.claude/*
# Skills are project tooling, shared by everyone working here.
!.claude/skills/
# The permission allowlist: read-only git/gh, the yarn scripts, and the search tools. It exists so a
# session spends its interruptions on decisions rather than on `yarn typecheck` for the ninth time.
# Deliberately absent: commit, push, deploy, rm — those stay a question every time.
!.claude/settings.json

wireframes

# `alepha pack` writes the artifact next to the app when -o is omitted.
*.tar.gz

# ACE-Step writes progress estimates next to the working directory.
.cache/

# Studio output kept for listening back to — takes, smoke runs and variants. Local scratch, not
# repo content: the directory reached 219 MB of wav/mp3/png in ordinary use, and git history is
# permanent, so committing it would weigh on every clone forever with no easy way back. A caption
# worth keeping belongs in the lane's AGENTS.md as text; the audio it produced does not.
studio/examples/
