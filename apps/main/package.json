{
  "name": "@lindocara/main",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "alepha dev",
    "build": "alepha build",
    "deploy": "alepha platform up -e production",
    "dev:legacy": "node ../../scripts/prepare-local-env.mjs && vite dev --config vite.legacy.config.ts",
    "build:legacy": "vite build --config vite.legacy.config.ts",
    "preview": "vite preview --config vite.legacy.config.ts",
    "deploy:legacy": "npm run build:legacy && wrangler deploy --config dist/lindocara/wrangler.json"
  },
  "dependencies": {
    "@lindocara/client": "*",
    "@lindocara/server": "*",
    "alepha": "*"
  }
}
