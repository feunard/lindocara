{
  "name": "lindocara",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    ".vendor/alepha",
    ".vendor/@alepha/*"
  ],
  "type": "module",
  "scripts": {
    "priest:build": "node studio/pixel-art/priest-rig/bake.mjs",
    "priest:check": "node studio/pixel-art/priest-rig/validate.mjs",
    "priest:studio": "node studio/pixel-art/priest-rig/bake.mjs --serve",
    "dev": "yarn workspace @lindocara/main run dev",
    "build": "yarn workspace @lindocara/main run build",
    "deploy": "yarn workspace @lindocara/main run deploy",
    "lab": "yarn workspace @lindocara/lab run dev",
    "test": "yarn alepha test",
    "test:watch": "vitest",
    "test:engine": "vitest run --project engine",
    "test:server": "vitest run --project server",
    "test:renderer": "vitest run --project renderer",
    "test:client": "vitest run --project client",
    "test:editor": "vitest run --project editor",
    "test:ui": "vitest run --project renderer --project client --project editor",
    "test:runtime": "vitest run --project engine --project server --project renderer --project client",
    "test:ui:runtime": "vitest run --project renderer --project client",
    "test:catalog": "vitest run --project catalog",
    "test:hd2d": "vitest run --project hd2d",
    "test:audio": "vitest run --project audio",
    "test:lab": "vitest run --project lab",
    "lint": "yarn alepha lint",
    "loadtest": "node scripts/loadtest.mjs",
    "map:build": "tsx scripts/build-map.ts",
    "map:proving": "tsx scripts/build-proving-map.ts",
    "adventure:proving": "tsx scripts/seed-proving-adventure.ts",
    "map:showcase": "tsx scripts/build-showcase-map.ts",
    "adventure:showcase": "tsx scripts/seed-showcase-adventure.ts",
    "seed:brumeval": "tsx scripts/legacy/seed-brumeval.ts",
    "seed:sombregue": "tsx scripts/legacy/seed-sombregue.ts",
    "adventure:build:liin": "tsx scripts/legacy/liin-adventure/build.ts",
    "adventure:render": "tsx scripts/render-adventure-maps.ts",
    "adventure:build:baie": "tsx scripts/legacy/baie-cent-voiles/build.ts",
    "adventure:build:city": "tsx scripts/legacy/cite-assiegee/build.ts",
    "adventure:export": "tsx scripts/adventure-io.ts export",
    "adventure:import": "tsx scripts/adventure-io.ts import",
    "map:check": "yarn map:build && git diff --exit-code -- packages/engine/src/generated/zones/verdant-reach-tiles.ts packages/engine/src/generated/zones/mmo-test-zone-tiles.ts packages/engine/src/generated/zones/sunken-isles-tiles.ts",
    "catalog:build": "yarn workspace @lindocara/catalog run catalog:build",
    "catalog:check": "yarn workspace @lindocara/catalog run catalog:check",
    "music:catalog": "tsx scripts/build-music-catalog.ts",
    "music:check": "tsx scripts/build-music-catalog.ts --check",
    "typecheck": "yarn typecheck:engine && yarn typecheck:hd2d && yarn typecheck:audio && yarn typecheck:lab && yarn typecheck:server && yarn typecheck:renderer && yarn typecheck:client && yarn typecheck:editor && yarn typecheck:testing && yarn typecheck:catalog && yarn typecheck:main && tsc -p tsconfig.tooling.json && tsc -p tsconfig.tooling.api.json",
    "typecheck:engine": "tsc -p packages/engine/tsconfig.json",
    "typecheck:hd2d": "tsc -p packages/hd2d/tsconfig.json",
    "typecheck:audio": "tsc -p packages/audio/tsconfig.json",
    "typecheck:lab": "tsc -p apps/lab/tsconfig.json && tsc -p apps/lab/tsconfig.api.json",
    "typecheck:server": "tsc -p packages/server/tsconfig.json",
    "typecheck:renderer": "tsc -p packages/renderer/tsconfig.json",
    "typecheck:client": "tsc -p packages/client/tsconfig.json && tsc -p packages/client/tsconfig.api.json",
    "typecheck:editor": "tsc -p packages/editor/tsconfig.json && tsc -p packages/editor/tsconfig.api.json",
    "typecheck:testing": "tsc -p packages/testing/tsconfig.json",
    "typecheck:main": "tsc -p apps/main/tsconfig.json",
    "check": "yarn catalog:check && yarn music:check && yarn map:check && yarn priest:check && yarn lint && yarn typecheck && yarn test",
    "check:runtime": "yarn lint && yarn typecheck && yarn test:runtime && yarn test:ui:runtime && yarn build",
    "typecheck:catalog": "tsc -p packages/catalog/tsconfig.json",
    "clean": "node -e \"const fs=require('node:fs'); for (const path of ['apps/main/dist','apps/lab/dist','apps/lab/dist-client']) fs.rmSync(path,{recursive:true,force:true})\"",
    "smoke": "tsx scripts/smoke-boot.ts",
    "verify": "yarn alepha verify",
    "v": "yarn alepha verify"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "alepha": "*",
    "jsdom": "^29.1.1",
    "playwright": "1.62.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shadcn": "^4.13.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.2",
    "tsx": "4.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "ws": "^8.21.0"
  },
  "resolutions": {
    "@esbuild-kit/core-utils/esbuild": "^0.25.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@4.18.0"
}
