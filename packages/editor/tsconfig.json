{
  // The creator tools: the adventure/map editor UI and its PixiJS authoring stage. Browser +
  // React. Sits on top of the client base (i18n, api, store, shadcn components) and the renderer
  // (the shared drawing layer). Depends on engine, renderer and client.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "@testing-library/jest-dom"],
    "jsx": "react-jsx",
    // The client's shadcn components (imported via @lindocara/client) use the `@/` alias
    // internally; map it to the client source so they resolve when loaded through this program.
    // Matches the global Vite alias, which already points `@` at the client source.
    "paths": { "@/*": ["../client/src/*"] }
  },
  "include": ["src", "test"],
  // Files that import `alepha`/`alepha/react*` are excluded here and typechecked by
  // `tsconfig.api.json` instead — see that file's docblock for why (mirrors
  // `packages/client/tsconfig.json`'s identical split, added at the same task).
  "exclude": [
    "src/ui/editor/AdventureEditorScreen.tsx",
    "src/ui/editor/AdventureSettingsDialog.tsx",
    "src/ui/editor/QuestWorkspaceDialog.tsx",
    "src/ui/editor/RegistryDialog.tsx",
    "test/editor-shell.test.tsx",
    "test/editor-bootstrap.test.tsx",
    "test/adventure-settings-dialog.test.tsx",
    "test/quest-workspace-dialog.test.tsx",
    "test/registry-dialog.test.tsx"
  ]
}
