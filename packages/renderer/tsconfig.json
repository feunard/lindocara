{
  // The HD-2D rendering layer (`src/hd2d/`, on three) plus the framework-free art/draw arithmetic,
  // local input and the locale core. Browser (DOM) but React-free by design. PixiJS was retired in
  // 2026-08-04; the editor's stage will build on this again once it is rebuilt on `@lindocara/hd2d`.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "@testing-library/jest-dom"]
  },
  "include": ["src", "test"]
}
