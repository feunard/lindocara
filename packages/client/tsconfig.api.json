{
  // `alepha`'s package.json points its "types" condition at raw source (`.vendor/alepha/src/core/
  // index.ts`, not a compiled .d.ts), so any file importing `alepha`/`alepha/react/router` pulls
  // the WHOLE framework source tree into whichever program does the resolving, type-checked under
  // THAT program's compilerOptions — including `alepha/server`/`alepha/system`'s Node-only
  // providers, reached transitively even from the browser-only `alepha/react/router` entry (tsc
  // resolves the `types` export condition, not `browser` — there is no way to make it pick the
  // narrower browser variant for type-checking, since `types` is always first-matched). Under
  // `tsconfig.json`'s stricter-than-`alepha`-itself bundle (`exactOptionalPropertyTypes`,
  // `noUncheckedIndexedAccess`, …) that source fails to type-check by the hundreds — none of it
  // is code this repo owns or should patch. `packages/server/tsconfig.api.json` hit the identical
  // problem first; this mirrors its fix: a separate program, extending alepha's OWN base config
  // (which lacks those extra flags) instead of this package's own `tsconfig.json`.
  //
  // Scope started narrow (Task 1: only `ui/AppRouter.tsx` + its test) and Task 2 grew it by the
  // files it added/touched that import `alepha`/`alepha/react/*`: `state/atoms.ts` (the `$atom`
  // definitions) and the five UI components that read/write them through `useStore`/`useSelector`
  // (`Hud`, `QuickItemBar`, `InventoryOverlay`, `QuestJournalOverlay`, `AdventureTestOverlay`),
  // plus their tests. Each is also excluded from `tsconfig.json` so it is not double-checked under
  // two incompatible strictness regimes. `state/navigation.ts` deliberately has NO `alepha` import
  // of its own (see its docblock) and is NOT listed here — it typechecks fine, and more usefully
  // stays reachable, from the plain `tsconfig.json` program (`game/session.ts`, `store.ts`).
  // Later tasks (the auth/launch/game/editor routes) will keep adding files here — or, if the
  // alepha surface ends up touching most of the package, this split may be worth reconsidering as
  // one program extending alepha's base for the whole package instead of two diverging ones.
  // Flagged, not decided, in the Task 1 report and still true after Task 2.
  "extends": "../../.vendor/alepha/tsconfig.base.json",
  "compilerOptions": {
    // No `lib` override: alepha's own internals (`Alepha.ts`) use ES2024 Iterator Helpers
    // (`MapIterator.filter`), which `ES2022` doesn't have. Leaving `lib` unset lets it default
    // from `target: "esnext"` (inherited from the base) — ESNext + DOM, same as
    // `tsconfig.api.json`'s server twin, which doesn't override `lib` either.
    "types": ["vite/client", "@testing-library/jest-dom", "node", "bun"],
    "jsx": "react-jsx",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "src/ui/AppRouter.tsx",
    "test/app-router.test.tsx",
    "src/state/atoms.ts",
    "src/ui/hud/Hud.tsx",
    "src/ui/hud/QuickItemBar.tsx",
    "src/ui/InventoryOverlay.tsx",
    "src/ui/QuestJournalOverlay.tsx",
    "src/ui/AdventureTestOverlay.tsx",
    "src/ui/AuthScreen.tsx",
    "src/ui/LaunchScreens.tsx",
    "test/atoms.test.tsx",
    "test/hud.test.tsx",
    "test/quest-journal-overlay.test.tsx",
    "test/inventory-merchant.test.tsx",
    "test/adventure-test-overlay.test.tsx",
    "test/auth-screen.test.tsx",
    "test/launch-screens.test.tsx"
  ]
}
