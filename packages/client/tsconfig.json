{
  // The React front end: app shell, screens, HUD, shadcn/Tiny-Swords component trees, the client
  // store, api and the game-session glue (net/input/sound/session). Browser + React. Depends on
  // engine and renderer. The `@/` alias is the client source root and is shared (via the Vite
  // alias) with the editor package, which builds on this base.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "@testing-library/jest-dom"],
    "jsx": "react-jsx",
    "paths": { "@/*": ["./src/*"] }
  },
  // Files that import `alepha`/`alepha/react*` are excluded here and typechecked by
  // `tsconfig.api.json` instead — see that file's docblock for why. Task 2 added `state/atoms.ts`
  // plus the five UI components that read/write its atoms (`Hud`, `QuickItemBar`,
  // `InventoryOverlay`, `QuestJournalOverlay`, `AdventureTestOverlay`) and their tests — `App.tsx`
  // (the only thing in THIS program that used to reach them) no longer renders any of the five, so
  // this program never sees them transitively either. `state/navigation.ts` has no `alepha` import
  // of its own (by design — see its docblock) and stays in this program. Task 3 added
  // `AuthScreen.tsx` (now `useAuth`/`useAlepha`/`useRouter`) and `LaunchScreens.tsx` (its
  // `ContinueScreen` now `useAuth`) plus their tests. Task 6 added `TitleScreen.tsx`/`MainMenu.tsx`/
  // `CreditsScreen.tsx` (now `useRouter()` directly, off the store's dead `setScreen` shim) —
  // `LegacyShell.tsx` (the only thing in THIS program that used to reach any of the screens named
  // in this comment) dropped every one of their imports and render branches for the same reason it
  // already had to for the HUD tree (Task 2) and auth/launch screens (Task 3): a dynamic `import()`
  // still pulls its target's full transitive type graph into whichever `tsc` program contains the
  // importing file, so even `LegacyShell.tsx`'s lazy `@lindocara/editor` import had to go once the
  // editor package itself started importing `alepha/react*` this task — see that file's own
  // docblock for the full trail.
  "include": ["src", "test"],
  "exclude": [
    "src/ui/AppRouter.tsx",
    "test/app-router.test.tsx",
    "test/game-route.test.tsx",
    "test/game-route-back.test.tsx",
    "src/state/atoms.ts",
    "src/ui/hud/Hud.tsx",
    "src/ui/hud/ActionDock.tsx",
    "src/ui/hud/QuickItemBar.tsx",
    "src/ui/InventoryOverlay.tsx",
    "src/ui/QuestJournalOverlay.tsx",
    "src/ui/AdventureTestOverlay.tsx",
    "src/ui/AuthScreen.tsx",
    "src/ui/LaunchScreens.tsx",
    "src/ui/TitleScreen.tsx",
    "src/ui/MainMenu.tsx",
    "src/ui/CreditsScreen.tsx",
    "src/ui/admin/AdminRouter.tsx",
    "src/ui/admin/AdminShell.tsx",
    "test/atoms.test.tsx",
    "test/hud.test.tsx",
    "test/quick-item-bar.test.tsx",
    "test/quest-journal-overlay.test.tsx",
    "test/inventory-merchant.test.tsx",
    "test/adventure-test-overlay.test.tsx",
    "test/auth-screen.test.tsx",
    "test/launch-screens.test.tsx",
    "test/admin-shell.test.tsx",
    "test/main-menu.test.tsx"
  ]
}
