{
  // The one root program, for files that need Node types the packages don't: the app's Vite config,
  // every package's vitest config, the root scripts — plus the engine's
  // tests, which use Node globals (crypto) that the engine's deliberately pure src tsconfig can't
  // host. Every other package typechecks its own src + test/ in its own tsconfig. The server's own
  // drizzle config died with the legacy retirement (Task 6, 2026-07-30 alepha-migration
  // deploy-cleanup) — Alepha's ORM owns migrations now.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": [
    "apps/main/vite.config.ts",
    "packages/*/vitest.config.ts",
    "scripts/**/*.ts",
    "packages/engine/test/**/*.ts"
  ],
  // The one root script that imports `alepha` (transitively, through `@lindocara/server`) and so
  // cannot be checked under this program's stricter-than-alepha base. It has its own program,
  // `tsconfig.tooling.api.json`, which `npm run typecheck` runs beside this one — see that file's
  // header. Excluded here so it is never checked under two incompatible regimes.
  "exclude": ["scripts/build-proving-map.ts"]
}
