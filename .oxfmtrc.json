{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": false,
  "semi": true,
  "trailingComma": "all",
  "sortImports": true,
  "sortTailwindcss": {
    "functions": ["cn", "clsx", "cva", "tw"]
  },
  "ignorePatterns": [
    ".vendor",
    ".claude",
    "**/*.md",
    "studio",
    "adventures",
    "**/generated",
    "apps/main/migrations",
    "packages/server/migrations/meta",
    "apps/lab/public/maps",
    "packages/catalog/assets/index.json",
    "packages/renderer/src/assets/characters/priest/*.json",
    "packages/renderer/src/assets/bonus/assassin-v2/*.json",
    "packages/catalog/assets/lindocara-asset-catalog.json",
    "packages/server/src/worker-configuration.d.ts",
    "**/.playwright",
    "**/playwright-report",
    "**/test-results"
  ]
}
